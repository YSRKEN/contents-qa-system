# 作品DBの置き場所（既定: リポジトリ直下の data/）
CQS_DATA_DIR=./data

# --- LLM（任意） -------------------------------------------------------------
# 未設定でもシステムは動く。回答生成の代わりに、貼れるプロンプトを出す。
# 詳しくは docs/llm.md

# OpenAI
#OPENAI_API_KEY=
#CQS_MODEL=gpt-4o-mini

# OpenAI互換のローカルサーバ（LM Studio / Ollama / vLLM など。キーは不要なことが多い）
#CQS_LLM_BASE_URL=http://localhost:1234/v1
#CQS_MODEL=

# Anthropic
#ANTHROPIC_API_KEY=
#CQS_MODEL=claude-opus-5

# openai | anthropic | none。省略時は上の設定から自動で決める
#CQS_LLM_PROVIDER=

# --- 取得 --------------------------------------------------------------------
# 取得時のUser-Agent。405やRSTで弾かれるサイトはここを変えると通ることがある。
CQS_USER_AGENT=contents-qa-system/0.1 (personal research bot)

# robots.txt を確認するか。既定は確認しない（0）。1 にすると拒否URLを取得しなくなる。
# どちらの設定でも、同一ホストへの連続アクセス間隔（既定1.5秒）は常に効く。
CQS_RESPECT_ROBOTS=0

# X（旧Twitter）の取得に使うFxTwitter互換APIの基点
CQS_FXTWITTER_API=https://api.fxtwitter.com
